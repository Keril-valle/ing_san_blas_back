# Copiar a .env y completar valores. En producción (Railway):
# FRONTEND_URL=https://parroquiasanblas.org
# CORS_ORIGINS debe incluir el dominio canónico del sitio.
# NETLIFY_BUILD_HOOK_URL = Site settings → Build & deploy → Build hooks (POST)

PORT=3000
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://parroquiasanblas.org,https://www.parroquiasanblas.org,https://sanblasfrontend.netlify.app
NETLIFY_BUILD_HOOK_URL=
