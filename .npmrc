# Security: enforce HTTPS registry only
registry=https://registry.npmjs.org/

# Strict SSL checking
strict-ssl=true

# Auto-install peer dependencies (pnpm default)
auto-install-peers=true

# pnpm 11 intenta verificar el lockfile contra el registry antes de cada script.
# En esta red eso falla con UNABLE_TO_VERIFY_LEAF_SIGNATURE y nunca arranca Nest.
verify-deps-before-run=false
